# Salin file ini menjadi .env.local di folder web/
# Jangan commit file .env.local

JWT_SECRET=ganti-dengan-secret-acak
JWT_EXPIRES_IN=24h
PORT=3000
# Opsional: hanya dengan secret ini bisa membuat akun admin lewat API (jangan taruh di UI)
# ADMIN_SETUP_SECRET=

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
